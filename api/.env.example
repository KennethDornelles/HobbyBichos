# Copie este arquivo para .env e preencha os valores conforme seu ambiente.
# Para Gmail, crie uma senha de app em https://myaccount.google.com/apppasswords

# =============================================================================
# DATABASE
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hobbybichos
DB_USER=postgres
DB_PASS=postgres

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=3600s

# =============================================================================
# EMAIL - GMAIL SMTP (Uso pessoal/desenvolvimento)
# =============================================================================
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password
GMAIL_FROM=your_gmail@gmail.com

# =============================================================================
# EMAIL - SENDGRID (Produção - Transacional)
# =============================================================================
# Criar conta em: https://sendgrid.com
# Gerar API Key em: Settings > API Keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@seudominio.com
SENDGRID_FROM_NAME=HobbyBichos

# =============================================================================
# SMS - ZENVIA
# =============================================================================
# Criar conta em: https://www.zenvia.com
# Gerar token em: API > Tokens
ZENVIA_API_TOKEN=seu_token_zenvia_aqui
ZENVIA_SMS_FROM=HobbyBichos  # Remetente (até 11 caracteres alfanuméricos)

# =============================================================================
# WHATSAPP - Opção 1: META BUSINESS API (Oficial)
# =============================================================================
# Configurar em: https://developers.facebook.com/apps
# Documentação: https://developers.facebook.com/docs/whatsapp/cloud-api
META_WHATSAPP_TOKEN=seu_token_meta_business_api
META_WHATSAPP_PHONE_NUMBER_ID=seu_phone_number_id
META_WHATSAPP_BUSINESS_ACCOUNT_ID=seu_business_account_id
META_WHATSAPP_VERSION=v18.0  # Versão da API

# =============================================================================
# WHATSAPP - Opção 2: ZENVIA (Mais simples)
# =============================================================================
# Criar conta em: https://www.zenvia.com
# Habilitar canal WhatsApp no painel
ZENVIA_WHATSAPP_TOKEN=seu_token_zenvia_whatsapp
ZENVIA_WHATSAPP_FROM=5511999999999  # Número no formato internacional

# =============================================================================
# REDIS - Para filas de notificação (BullMQ)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Deixe vazio se não houver senha
REDIS_DB=0  # Database do Redis (0-15)

# =============================================================================
# EXPO PUSH NOTIFICATIONS
# =============================================================================
# Não precisa de API key - usa tokens dos dispositivos
# Documentação: https://docs.expo.dev/push-notifications/overview/

# =============================================================================
# APLICAÇÃO
# =============================================================================
NODE_ENV=development  # development | production
PORT=3000
API_URL=http://localhost:3000

# =============================================================================
# LOGS E MONITORAMENTO (Opcional)
# =============================================================================
LOG_LEVEL=debug  # error | warn | info | debug
SENTRY_DSN=  # Para monitoramento de erros em produção

# =============================================================================
# NGROK - Para expor o ambiente de desenvolvimento
# =============================================================================
# Crie sua conta em https://ngrok.com para obter um authtoken e um domínio fixo
NGROK_AUTHTOKEN=seu_authtoken_do_ngrok
NGROK_DOMAIN=seu_dominio_fixo.ngrok-free.dev
