
# Copie este arquivo para .env e preencha os valores conforme seu ambiente.
# Para Gmail, crie uma senha de app em https://myaccount.google.com/apppasswords

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hobbybichos
DB_USER=postgres
DB_PASS=postgres

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=3600s

# Gmail SMTP
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password
GMAIL_FROM=your_gmail@gmail.com

# Outras variáveis necessárias
NODE_ENV=production
PORT=3000
