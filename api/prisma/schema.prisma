generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- Notificações Multicanal ---

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationCategory {
  APPOINTMENT_REMINDER
  ORDER_CONFIRMED
  PAYMENT_REMINDER
  OTP
  MARKETING
}

enum NotificationChannel {
  PUSH
  WHATSAPP
  SMS
  EMAIL
}

model Notification {
  id         String                @id @default(uuid())
  userId     String
  storeId    String?
  title      String
  body       String
  read       Boolean              @default(false)
  data       Json?
  status     NotificationStatus   @default(PENDING)
  category   NotificationCategory
  channel    NotificationChannel  @default(PUSH)
  error      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([storeId])
  @@index([category])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  deviceId   String
  expoToken  String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([expoToken])
  @@map("push_tokens")
}

model UserNotificationPreference {
  id         String   @id @default(uuid())
  userId     String
  storeId    String
  category   NotificationCategory
  push       Boolean  @default(true)
  email      Boolean  @default(true)
  sms        Boolean  @default(false)
  whatsapp   Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId, category])
  @@map("user_notification_preferences")
}

enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  EMPLOYEE
  CLIENT
}

model Store {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  phone            String?
  whatsappNumber   String?
  pixKey           String?
  address          String?
  city             String?
  state            String?
  latitude         Float?
  longitude        Float?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employees        User[]             @relation("StoreEmployees")
  appointments     Appointment[]
  orders           Order[]
  productStocks    ProductStock[]
  services         Service[]
  reviews          Review[]
  businessHours    StoreBusinessHour[]
  exclusions       StoreExclusion[]
  pets             Pet[]
  
  transfersFrom    StockTransfer[]     @relation("FromStore")
  transfersTo      StockTransfer[]     @relation("ToStore")

  notifications    Notification[]
  userNotificationPreferences UserNotificationPreference[]

  @@map("stores")
}

model StoreBusinessHour {
  id        String @id @default(uuid())
  storeId   String
  weekday   Int    // 0=Domingo, 6=Sábado
  openTime  String // formato 'HH:mm'
  closeTime String // formato 'HH:mm'
  store     Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("store_business_hours")
}

model StoreExclusion {
  id      String   @id @default(uuid())
  storeId String
  date    DateTime
  reason  String?
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([date])
  @@map("store_exclusions")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String   @unique
  role      Role     @default(CLIENT)
  storeId   String?
  birthDate DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store                    Store?                    @relation("StoreEmployees", fields: [storeId], references: [id])
  pets                     Pet[]
  orders                   Order[]
  professionalAppointments Appointment[]             @relation("ProfessionalAppointments")
  clientAppointments       Appointment[]             @relation("ClientAppointments")
  recoveryCodes            RecoveryCode[]
  reviews                  Review[]                  @relation("ReviewUser")
  reviewsAsEmployee        Review[]                  @relation("ReviewEmployee")
  loyaltyAccount           LoyaltyAccount?
  memberCodes              MemberCode[]
  referralsReceived        Referral[]                @relation("ReferralReferee")
  birthdayAwards           LoyaltyBirthdayAward[]
  stockTransfers           StockTransfer[]           @relation("RequestedBy")
  cart                     Cart?
  commissions              Commission[]
  saleItems                OrderItem[]               @relation("SaleProfessional")

  notifications Notification[]
  pushTokens PushToken[]
  userNotificationPreferences UserNotificationPreference[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RecoveryCode {
  id        String   @id @default(uuid())
  userId    String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@map("recovery_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Pet {
  id        String   @id @default(uuid())
  name      String
  species   String
  breed     String?
  ownerId   String
  storeId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        User          @relation(fields: [ownerId], references: [id])
  store        Store         @relation(fields: [storeId], references: [id])
  appointments Appointment[]

  @@map("pets")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  barcode   String?  @unique
  basePrice Decimal  @db.Decimal(10, 2)
  category  String   @default("Todos")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks     ProductStock[]
  orderItems OrderItem[]
  cartItems  CartItem[]
  loyaltyRewards LoyaltyReward[]
  transfers   StockTransfer[]
  images     String[] @default([])
  sku        String?
  commissionPercentage Int? @default(0)

  @@map("products")
}

model ProductStock {
  id        String   @id @default(uuid())
  productId String
  storeId   String
  quantity  Int      @default(0)
  minStock  Int      @default(5)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@map("product_stocks")
}

model Service {
  id          String   @id @default(uuid())
  storeId     String
  name        String
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int      @default(30)
  commissionPercentage Int? @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  orderItems   OrderItem[]
  loyaltyRewards LoyaltyReward[]

  @@map("services")
}

model Appointment {
  id             String   @id @default(uuid())
  storeId        String
  startsAt       DateTime
  professionalId String?
  userId         String
  petId          String
  serviceId      String
  status         String   @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store        Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  professional User?   @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  user         User    @relation("ClientAppointments", fields: [userId], references: [id])
  pet          Pet     @relation(fields: [petId], references: [id])
  service      Service @relation(fields: [serviceId], references: [id])
  review       Review?

  @@index([storeId])
  @@index([userId])
  @@index([professionalId])
  @@index([startsAt])
  @@map("appointments")
}

model Order {
  id        String   @id @default(uuid())
  storeId   String
  userId    String
  total     Decimal  @db.Decimal(10, 2)
  status    String   @default("PENDING") // PENDING, PAID, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  loyaltyTransactions LoyaltyTransaction[]
  redemptions LoyaltyRedemption[]

  @@index([storeId])
  @@index([userId])
  @@map("orders")
}

model Review {
  id            String   @id @default(uuid())
  stars         Int
  comment       String?
  userId        String
  storeId       String
  employeeId    String
  appointmentId String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation("ReviewUser", fields: [userId], references: [id])
  store       Store       @relation(fields: [storeId], references: [id])
  employee    User        @relation("ReviewEmployee", fields: [employeeId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("reviews")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  serviceId String?
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])
  service Service? @relation(fields: [serviceId], references: [id])
  professionalId String?
  professional   User?   @relation("SaleProfessional", fields: [professionalId], references: [id])

  @@map("order_items")
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId], name: "cartId_productId")
  @@map("cart_items")
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum TransactionType {
  PURCHASE
  WELCOME_BONUS
  BIRTHDAY
  REFERRAL
  REVIEW
  CHECK_IN
  SHARE
  ADMIN_ADJUSTMENT
  REDEMPTION
  EXPIRATION
}

enum RewardType {
  DISCOUNT_PERCENT
  DISCOUNT_FIXED
  FREE_SHIPPING
  FREE_PRODUCT
  FREE_SERVICE
  VOUCHER
}

enum RedemptionStatus {
  PENDING
  USED
  EXPIRED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  EXPIRED
}

model LoyaltyAccount {
  id             String              @id @default(uuid())
  userId         String              @unique
  currentPoints  Int                 @default(0)
  lifetimePoints Int                 @default(0)
  tier           LoyaltyTier         @default(BRONZE)
  tierExpiresAt  DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  redemptions  LoyaltyRedemption[]
  referrals    Referral[]           @relation("AccountReferrals")

  @@index([userId])
  @@index([tier])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id          String           @id @default(uuid())
  accountId   String
  points      Int
  type        TransactionType
  description String
  orderId     String?
  referenceId String?
  expiresAt   DateTime?
  expired     Boolean          @default(false)
  createdAt   DateTime         @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  order   Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id         String     @id @default(uuid())
  name       String
  description String
  pointsCost Int
  rewardType RewardType
  value      Decimal    @db.Decimal(10, 2)
  productId  String?
  serviceId  String?
  imageUrl   String?
  isActive   Boolean    @default(true)
  stockLimit Int?
  usedCount  Int        @default(0)
  validUntil DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  redemptions LoyaltyRedemption[]

  @@index([isActive])
  @@index([pointsCost])
  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id         String            @id @default(uuid())
  accountId  String
  rewardId   String
  pointsUsed Int
  code       String            @unique
  status     RedemptionStatus  @default(PENDING)
  usedAt     DateTime?
  expiresAt  DateTime
  orderId    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward  LoyaltyReward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([code])
  @@index([status])
  @@index([expiresAt])
  @@map("loyalty_redemptions")
}

model Referral {
  id           String          @id @default(uuid())
  referrerId   String
  refereeId    String?
  code         String          @unique
  status       ReferralStatus  @default(PENDING)
  pointsEarned Int             @default(0)
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  referrer LoyaltyAccount @relation("AccountReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User?           @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referrerId])
  @@index([refereeId])
  @@index([code])
  @@map("referrals")
}

model LoyaltyRule {
  id         String          @id @default(uuid())
  name       String          @unique
  actionType TransactionType
  pointsValue Int
  multiplier Decimal         @db.Decimal(5, 2) @default("1.00")
  maxPerDay  Int?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@map("loyalty_rules")
}

model LoyaltyBirthdayAward {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  points    Int
  awardedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year])
  @@index([userId])
  @@map("loyalty_birthday_awards")
}

model MemberCode {
  code      String  @id @db.Citext
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_codes")
}

model StockTransfer {
  id              String   @id @default(uuid())
  productId       String
  fromStoreId     String
  toStoreId       String
  quantity        Int
  requestedById   String
  completedById   String?
  reason          String?
  status          String   @default("COMPLETED") // COMPLETED, CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product       Product @relation(fields: [productId], references: [id])
  fromStore     Store   @relation("FromStore", fields: [fromStoreId], references: [id])
  toStore       Store   @relation("ToStore", fields: [toStoreId], references: [id])
  requestedBy   User    @relation("RequestedBy", fields: [requestedById], references: [id])

  @@index([productId])
  @@index([fromStoreId])
  @@index([toStoreId])
  @@map("stock_transfers")
}

model Commission {
  id             String   @id @default(uuid())
  professionalId String
  amount         Decimal  @db.Decimal(10, 2)
  status         String   @default("PENDING") // PENDING, PAID, CANCELLED
  sourceType     String // APPOINTMENT, ORDER
  sourceId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional User @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([status])
  @@map("commissions")
}