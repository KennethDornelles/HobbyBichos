{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mobile.app",
      "config": {
        "googleMapsApiKey": "AIzaSyB6s_mecHKsRBRK_SvmkSKxGmdosY0XFL8"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mobile.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB6s_mecHKsRBRK_SvmkSKxGmdosY0XFL8"
        }
      },
      "statusBarStyle": "light",
      "statusBarBackgroundColor": "#000000"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Permitir acesso à câmera para escanear códigos."
        }
      ]
    ],
    "scheme": "mobile",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "045e02b0-fac7-48b4-8a5a-d99ad405143f"
      }
    }
  }
}
