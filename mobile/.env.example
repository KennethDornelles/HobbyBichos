# Google Maps Platform Configuration
# Copie este arquivo para .env.local e adicione sua Google Maps API Key

# Google Maps API Key (obtenha em: https://console.cloud.google.com)
# Essa chave deve ter as seguintes APIs ativadas:
# - Places API (Nearby Search)
# - Distance Matrix API
# - Directions API
# - Maps SDK for Android (gratuito)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=SEU_API_KEY_AQUI

# URL da API backend
EXPO_PUBLIC_API_URL=http://localhost:3000/api
