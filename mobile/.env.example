# API Configuration for Different Environments

# For Android Emulator (10.0.2.2 is the special IP for localhost in Android emulator)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# For Physical Device (replace 192.168.0.100 with your machine's local IP)
# Run: npm run start:device
# EXPO_PUBLIC_API_URL=http://192.168.0.100:3000/api

# For Production
# EXPO_PUBLIC_API_URL=https://api.hobbybichos.com/api
